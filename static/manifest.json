{
  "manifest_version": 3,
  "name": "Canvas Syllabus Chat",
  "version": "1.0.0",
  "description": "Collects the syllabi of your Canvas courses and lets you ask an AI questions about them.",
  "action": {
    "default_title": "Canvas Syllabus Chat"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.instructure-uploads.com/*",
    "https://*.inscloudgate.net/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.simplesyllabus.com/*"
      ],
      "js": [
        "simplesyllabus.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
